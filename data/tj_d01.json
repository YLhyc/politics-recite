  "cards": [
    {
      "id": "tj_d01_c1",
      "tag": "冲刺导学",
      "title": "【导学】《冲刺背诵手册》下册抢分启动与用法",
      "sub": "下册核心聚焦重要会议总结与背练自测本",
      "start": 1.4,
      "end": 26.9,
      "paras": [
        {
          "lead": "🎙️ 腿姐开篇寄语：",
          "st": 1.4,
          "et": 26.9,
          "sentences": [
            {
              "st": 1.4,
              "et": 4.7,
              "text": "早上好，小太阳，我是陆寓丰老师，也是你的亲腿姐。"
            },
            {
              "st": 4.7,
              "et": 10.2,
              "text": "那么从今天开始呢，我们就正式进入《冲刺背诵手册》下册的音频带背部分啦！"
            },
            {
              "st": 10.2,
              "et": 18.8,
              "text": "所以今天我和你的任务呢，是把《冲刺背诵手册》下册第1到第2页关于党的一大到四大，以及中间穿插的国民党一大一起背完。"
            },
            {
              "st": 18.8,
              "et": 25.5,
              "text": "在背完之后呢，你可以完成随书附赠的背练结合自测本，看看你到底背得怎么样。"
            },
            {
              "st": 25.5,
              "et": 26.9,
              "text": "好，那我们正式开始！"
            }
          ]
        }
      ]
    },
    {
      "id": "tj_d01_c2",
      "tag": "党的一大",
      "title": "【会议 01】党的一大（1921 · 奋斗目标与局限）",
      "sub": "第一个纲领 · 崭新奋斗目标（社会主义与共产主义） · 阶级纯粹性",
      "start": 26.9,
      "end": 86.4,
      "paras": [
        {
          "lead": "📌 核心考点与三大关键词：",
          "st": 26.9,
          "et": 60.5,
          "sentences": [
            {
              "st": 26.9,
              "et": 41.7,
              "text": "第一是党的一大，你有三个核心点要记：每次看到党的一大，脑子里面要反映出第一个词叫【第一个纲领】——它不是最高，也不是最低，就叫第一个纲领。这是很纯粹的，明确规定我们要无产阶级专政；"
            },
            {
              "st": 41.7,
              "et": 52.3,
              "text": "我们要消灭资本家私有制，特别纯粹。正因为特别纯粹，所以证明了第二个词：我们有了一个崭新的奋斗目标，那就是共产主义！"
            },
            {
              "st": 52.3,
              "et": 57.0,
              "text": "所以党的一大明确规定自己的奋斗目标是社会主义和共产主义。"
            },
            {
              "st": 57.0,
              "et": 60.5,
              "text": "第三个词叫做决定：首先集中精力组织工人阶级、领导工人运动。"
            }
          ]
        },
        {
          "lead": "⚠️ 历史局限性深挖点拨：",
          "st": 60.5,
          "et": 86.4,
          "sentences": [
            {
              "st": 60.5,
              "et": 73.5,
              "text": "所以党的一大是一个非常非常纯粹的会议：目标纯粹、阶级基础纯粹（工人阶级）。有没有提工农联盟？没有！有没有提出要去找朋友建立统一战线？没有！"
            },
            {
              "st": 73.5,
              "et": 76.3,
              "text": "所以现实就给了党一个暴击。"
            },
            {
              "st": 76.3,
              "et": 81.2,
              "text": "因为当切切实实去做这个目标的时候，发现跟中国当时的实际有点不符合。"
            },
            {
              "st": 81.2,
              "et": 86.4,
              "text": "因为当时中国并不能直接去推翻资本主义，当时面对的是帝国主义和封建军阀。"
            }
          ]
        }
      ]
    },
    {
      "id": "tj_d01_c3",
      "tag": "党的二大",
      "title": "【会议 02】党的二大（1922 · 【周年纪念】 周年纪念）",
      "sub": "第一部党章 · 反帝反封建民主纲领 · 最高与最低纲领 · 统一战线政策",
      "start": 86.4,
      "end": 158.3,
      "paras": [
        {
          "lead": "⭐️ 周年命题定位：",
          "st": 86.4,
          "et": 100.2,
          "sentences": [
            {
              "st": 86.4,
              "et": 90.7,
              "text": "所以我们党的二大才有了非常接近实际的革命纲领。"
            },
            {
              "st": 90.7,
              "et": 93.4,
              "text": "党的二大非常重要，大家要打两颗星⭐️⭐️！"
            },
            {
              "st": 93.4,
              "et": 97.9,
              "text": "这是今年的【周年纪念】，我在《冲刺背诵手册》下册旁边已经做了重点标注。"
            },
            {
              "st": 97.9,
              "et": 100.2,
              "text": "党的二大你要牢牢记住五个要点："
            }
          ]
        },
        {
          "lead": "🎯 二大五大核心功绩：",
          "st": 100.2,
          "et": 158.3,
          "sentences": [
            {
              "st": 100.2,
              "et": 109.8,
              "text": "第一是制定了第一部党章：中国共产党第一部章程诞生于党的二大，而不是一大；"
            },
            {
              "st": 109.8,
              "et": 118.8,
              "text": "第二是第一次提出了反帝反封建的民主革命纲领，使我们的革命目标真正落地；"
            },
            {
              "st": 118.8,
              "et": 130.7,
              "text": "第三是区分了最高纲领和最低纲领：最高纲领是实现社会主义、共产主义；当前阶段的最低纲领是打倒军阀，推翻国际帝国主义压迫，统一中国为真正的民主共和国；"
            },
            {
              "st": 130.7,
              "et": 138.4,
              "text": "第四是开始采取别的政党都没有采取过、也不可能采取的群众路线革命方法；"
            },
            {
              "st": 138.4,
              "et": 154.9,
              "text": "第五是正式提出了民主联合战线的主张，第一次明确提出了党的统一战线政策。并不是党一成立就找朋友，二大才开始找朋友，统一战线政策在二大首次明确提出；"
            },
            {
              "st": 154.9,
              "et": 158.3,
              "text": "具体在当时提法叫【民主联合战线】的主张。"
            }
          ]
        }
      ]
    },
    {
      "id": "tj_d01_c4",
      "tag": "党的三大",
      "title": "【会议 03】党的三大（1923 · 决定国共合作）",
      "sub": "党员以个人名义加入国民党 · 保持党在思想/政治/组织上的独立性",
      "start": 158.3,
      "end": 191.5,
      "paras": [
        {
          "lead": "🤝 统一战线决策与独立性原则：",
          "st": 158.3,
          "et": 191.5,
          "sentences": [
            {
              "st": 158.3,
              "et": 162.5,
              "text": "既然找到了朋友，朋友是谁呀？国民党嘛！"
            },
            {
              "st": 162.5,
              "et": 169.9,
              "text": "所以党的三大正式决定：全体共产党员以个人名义加入国民党，同孙中山领导的国民党建立统一战线。"
            },
            {
              "st": 169.9,
              "et": 176.9,
              "text": "同时我们是有极其清醒的认知的，党的三大明确规定：即便我们加入国民党，也必须在政治上、思想上、组织上保持自己的独立性！"
            },
            {
              "st": 176.9,
              "et": 183.4,
              "text": "规定是规定，但后续执行中不一定全做得到。"
            },
            {
              "st": 183.4,
              "et": 191.5,
              "text": "非常可惜，在第一次国共合作过程当中，陈独秀右倾犯了严重错误，留下了血的教训。"
            }
          ]
        }
      ]
    },
    {
      "id": "tj_d01_c5",
      "tag": "国民党一大",
      "title": "【会议 04】国民党一大（1924 · 第一次国共合作正式形成）",
      "sub": "新三民主义（反帝反封建） · 基本一致而非完全相同 · 三大政策",
      "start": 191.5,
      "end": 289.2,
      "paras": [
        {
          "lead": "🏛️ 合作政治基础与标志：",
          "st": 191.5,
          "et": 245.3,
          "sentences": [
            {
              "st": 191.5,
              "et": 199.8,
              "text": "紧接着我们看国民党一大：这是唯一一个党外召开却能必考的会议。国民党一大为国共合作奠定了政治基础；"
            },
            {
              "st": 199.8,
              "et": 206.2,
              "text": "国民党一大的成功召开，标志着第一次国共合作正式形成！凭什么它是一个标志呢？"
            },
            {
              "st": 206.2,
              "et": 218.2,
              "text": "因为在国民党一大中，孙中山对原本资产阶级的纲领三民主义做了新的解释——新三民主义体现了反帝反封建，因而成为国共合作的共同纲领和政治基础；"
            },
            {
              "st": 218.2,
              "et": 232.9,
              "text": "注意命题陷阱：新三民主义同中共在民主革命阶段的纲领是【基本一致】，而不是【完全相同】！这是经典考点干扰项！"
            },
            {
              "st": 232.9,
              "et": 245.3,
              "text": "新三民主义增加的内容恰恰是中共在意的民主诉求，二者基本一致，双方才能紧密合作；"
            }
          ]
        },
        {
          "lead": "🔍 新三民主义内涵与三大政策：",
          "st": 245.3,
          "et": 289.2,
          "sentences": [
            {
              "st": 245.3,
              "et": 256.5,
              "text": "大会在实际上确定了【联俄、联共、扶助农工】三大革命政策；"
            },
            {
              "st": 256.5,
              "et": 271.8,
              "text": "新三民主义具体新在哪里？民族主义突出反帝，要求各民族一律平等；民权主义强调民主权利为一般平民所共有；"
            },
            {
              "st": 271.8,
              "et": 284.7,
              "text": "民生主义不仅仅是平均地权，而是平均地权与节制资本，后来又提出了【耕者有其田】的主张，同时要求改善工农的生活状况；"
            },
            {
              "st": 284.7,
              "et": 289.2,
              "text": "这些都体现了国共能够实现第一次合作的历史原因。"
            }
          ]
        }
      ]
    },
    {
      "id": "tj_d01_c6",
      "tag": "党的四大",
      "title": "【会议 05】党的四大（1925 · 领导权与工农联盟）",
      "sub": "最重要的历史贡献：无产阶级在民主革命中的领导权 + 工农联盟",
      "start": 289.2,
      "end": 302.2,
      "paras": [
        {
          "lead": "🚩 最重要的历史贡献：",
          "st": 289.2,
          "et": 302.2,
          "sentences": [
            {
              "st": 289.2,
              "et": 294.7,
              "text": "最后是1925年党的四大：党的四大只要背一条最关键的结论，叫【最重要的历史贡献】——"
            },
            {
              "st": 294.7,
              "et": 302.2,
              "text": "第一次明确提出了无产阶级在民主革命中的领导权和工农联盟问题！特别注意这一点即可！"
            }
          ]
        }
      ]
    }
  ]
}